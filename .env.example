# Telegram
BOT_TOKEN=
ADMIN_IDS=123456789
BOT_USERNAME=FourStepsVPNbot

# Optional: local Telegram Bot API server (when api.telegram.org is blocked)
# Leave empty to use official https://api.telegram.org
# TELEGRAM_API_ROOT=http://127.0.0.1:8081
TELEGRAM_API_ROOT=

# Database (Docker maps Postgres to host port 5433 on Windows; 5432 on Linux VPS)
DATABASE_URL=postgresql://vpn:vpn@127.0.0.1:5433/vpn

# Redis
REDIS_URL=redis://localhost:6379


# App — must be HTTPS for Telegram Mini App button
APP_URL=http://localhost:3000
SUBSCRIPTION_SECRET=change-me-to-long-random-string
