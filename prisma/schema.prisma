generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  OWNER
}

enum PlanType {
  STANDARD
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELLED
  REFUNDED
}

enum NodeType {
  STANDARD
  PREMIUM
}

enum SupportMessageAuthor {
  USER
  ADMIN
}

enum SupportTicketStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum BonusType {
  TELEGRAM_CHANNEL
}

enum BonusClaimStatus {
  APPLYING
  PENDING
  CONFIRMED
  REVOKED
}

model User {
  id                    String                 @id @default(cuid())
  telegramId            BigInt                 @unique
  username              String?
  firstName             String?
  lastName              String?
  avatarUrl             String?
  referralCode          String                 @unique
  referredById          String?
  referredBy            User?                  @relation("Referrals", fields: [referredById], references: [id])
  referrals             User[]                 @relation("Referrals")
  referralReward        ReferralReward?        @relation("ReferralRewardInvitee")
  referralRewards       ReferralReward[]       @relation("ReferralRewardReferrer")
  role                  UserRole               @default(USER)
  isBlocked             Boolean                @default(false)
  legalAcceptedAt       DateTime?
  legalVersion          String?
  subscriptions         Subscription[]
  payments              Payment[]
  devices               Device[]
  notificationReads     UserNotification[]
  directNotifications   Notification[]         @relation("DirectNotifications")
  supportTickets        SupportTicket[]
  bonusClaims           BonusClaim[]
  promoRedemptions      PromoRedemption[]
  ownerInvitesCreated   OwnerInvite[]          @relation("OwnerInviteCreator")
  ownerInviteRedemption OwnerInviteRedemption?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@map("users")
}

model Notification {
  id              String             @id @default(cuid())
  title           String
  body            String
  isActive        Boolean            @default(true)
  reads           UserNotification[]
  recipientUserId String?
  recipient       User?              @relation("DirectNotifications", fields: [recipientUserId], references: [id], onDelete: Cascade)
  dedupeKey       String?            @unique
  telegramSentAt  DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([isActive, createdAt])
  @@index([recipientUserId, isActive, createdAt])
  @@map("notifications")
}

model UserNotification {
  id             String       @id @default(cuid())
  userId         String
  notificationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@unique([userId, notificationId])
  @@index([notificationId])
  @@map("user_notifications")
}

model Subscription {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id])
  plan           PlanType
  status         SubscriptionStatus @default(ACTIVE)
  uuid           String             @unique
  subToken       String             @unique
  startsAt       DateTime           @default(now())
  expiresAt      DateTime
  isTrial        Boolean            @default(false)
  vpnSyncPending Boolean            @default(false)
  device         Device?
  h1CloudClients H1CloudClient[]
  bonusClaims    BonusClaim[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([userId])
  @@index([status, expiresAt])
  @@index([vpnSyncPending])
  @@map("subscriptions")
}

model H1CloudClient {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  nodeKey      String
  remoteName   String
  remoteUuid   String
  remoteLink   String
  remoteSubUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriptionId, nodeKey])
  @@unique([nodeKey, remoteName])
  @@unique([nodeKey, remoteUuid])
  @@index([subscriptionId])
  @@map("h1cloud_clients")
}

model Device {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String       @unique
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  uuid           String       @unique
  name           String       @default("Устройство")
  platform       String?
  isActive       Boolean      @default(true)
  lastSeenAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId])
  @@index([isActive])
  @@map("devices")
}

model Payment {
  id                    String        @id @default(cuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id])
  providerPaymentId     String?       @unique
  paymentProvider       String?
  amount                Int
  baseAmount            Int?
  durationMonths        Int           @default(1)
  feeAmount             Int?
  feePercent            Int?
  currency              String        @default("RUB")
  plan                  PlanType
  status                PaymentStatus @default(PENDING)
  description           String?
  paymentMethod         String?
  bank                  String?
  proofFileId           String?
  reviewedAt            DateTime?
  reviewedBy            String?
  appliedAt             DateTime?
  appliedSubscriptionId String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([userId])
  @@index([appliedAt])
  @@map("payments")
}

model Node {
  id          String   @id @default(cuid())
  name        String
  host        String
  port        Int      @default(443)
  apiHost     String?
  apiPort     Int      @default(10085)
  inboundTag  String   @default("vless-reality")
  type        NodeType
  maxUsers    Int?
  isActive    Boolean  @default(true)
  publicKey   String
  shortId     String
  sni         String
  fingerprint String   @default("chrome")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("nodes")
}

model SupportTicket {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String
  body          String
  attachmentUrl String?
  status        SupportTicketStatus    @default(NEW)
  messages      SupportTicketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  author SupportMessageAuthor
  body   String

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

model BonusClaim {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  type   BonusType
  status BonusClaimStatus @default(APPLYING)

  bonusDays Int @default(7)

  channelUsername String

  baseExpiresAt   DateTime
  targetExpiresAt DateTime

  grantedAt    DateTime?
  confirmAfter DateTime?
  revokedAt    DateTime?

  syncPending Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type])
  @@index([status, confirmAfter])
  @@index([syncPending])
  @@map("bonus_claims")
}

model PromoCode {
  id   String   @id @default(cuid())
  code String   @unique
  plan PlanType
  days Int

  maxUses      Int?
  usedCount    Int  @default(0)
  perUserLimit Int  @default(1)

  validUntil DateTime?
  isActive   Boolean   @default(true)

  createdByTelegramId BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions PromoRedemption[]

  @@index([isActive, validUntil])
  @@map("promo_codes")
}

model PromoRedemption {
  id String @id @default(cuid())

  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan PlanType
  days Int

  createdAt DateTime @default(now())

  @@index([promoCodeId, userId])
  @@index([userId, createdAt])
  @@map("promo_redemptions")
}

model ReferralReward {
  id String @id @default(cuid())

  inviteeId String @unique
  invitee   User   @relation("ReferralRewardInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  referrerId String
  referrer   User   @relation("ReferralRewardReferrer", fields: [referrerId], references: [id], onDelete: Cascade)

  inviteeTrial  Boolean?
  referrerBonus Boolean?

  inviteeSubscriptionId  String?
  referrerSubscriptionId String?

  inviteeSyncPending  Boolean @default(false)
  referrerSyncPending Boolean @default(false)

  appliedAt DateTime?

  legacyBackfilled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referrerId, createdAt])
  @@index([inviteeSyncPending])
  @@index([referrerSyncPending])
  @@map("referral_rewards")
}

model OwnerInvite {
  id          String                  @id @default(cuid())
  token       String                  @unique
  days        Int
  isActive    Boolean                 @default(true)
  createdById String
  createdBy   User                    @relation("OwnerInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  redemptions OwnerInviteRedemption[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([createdById, createdAt])
  @@index([isActive])
  @@map("owner_invites")
}

model OwnerInviteRedemption {
  id          String      @id @default(cuid())
  inviteId    String
  invite      OwnerInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  userId      String      @unique
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  daysGranted Int
  redeemedAt  DateTime    @default(now())
  appliedAt   DateTime?

  @@index([inviteId])
  @@map("owner_invite_redemptions")
}
